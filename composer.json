{
  "name": "code-tool/doctrine-dbal-jaeger",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "doctrine/dbal": "^4.0",
    "code-tool/jaeger-client-php": "^3"
  }
  ,
  "require-dev": {
    "roave/security-advisories": "dev-latest"
  },
  "config": {
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "Doctrine\\DBAL\\Jaeger\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Doctrine\\DBAL\\Jaeger\\Tests\\": "tests/"
    }
  },
  "prefer-stable": true,
  "minimum-stability": "dev"
}
